# Copy to .env.local and fill in local-only values.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5433
# postgresql://USER:PASSWORD@127.0.0.1:PORT/DATABASE
# Use a complete URL; dotenv does not expand other variables here.
DATABASE_URL=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
